{
  "name": "Halloween Glass",
  "type": "dark",
  "colors": {
    "bg": "transparent",
    "background": {
      "type": "overlay",
      "overlay": "halloween-themes.storm",
      "opacity": 1
    },
    "surface": "rgba(8, 5, 14, 0.18)",
    "surfaceRaised": "rgba(14, 9, 24, 0.30)",
    "border": "rgba(150, 170, 230, 0.12)",
    "borderStrong": "rgba(180, 200, 255, 0.18)",
    "panelBorder": "rgba(150, 170, 230, 0.08)",
    "editorBg": "rgba(8, 5, 14, 0.34)",
    "titleBarBg": "rgba(8, 5, 14, 0.14)",
    "activityBarBg": "rgba(8, 5, 14, 0.10)",
    "statusBarBg": "rgba(8, 5, 14, 0.16)",
    "accent": "#8aa4ff",
    "accentHover": "#a8bbff",
    "accentActive": "#c3d0ff",
    "onAccent": "#080512",
    "text": "#eef1ff",
    "textSecondary": "#b9c2e0",
    "textMuted": "#7f89a8",
    "error": "#ff5d7a",
    "errorHover": "#ff7a93",
    "onError": "#14030a",
    "warning": "#e0b45a",
    "success": "#75d6a0",
    "info": "#9b8cff",
    "hover": "rgba(160, 180, 255, 0.08)",
    "active": "rgba(160, 180, 255, 0.14)",
    "scrollbarThumb": "rgba(160, 180, 255, 0.16)",
    "scrollbarThumbHover": "rgba(160, 180, 255, 0.28)",
