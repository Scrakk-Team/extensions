      "scope": "comment",
      "foreground": "#7f89a8",
      "fontStyle": "italic"
    },
    {
      "scope": "string",
      "foreground": "#d9c7a3"
    },
    {
      "scope": "string.regexp",
      "foreground": "#d9c7a3"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#9b8cff"
    },
    {
      "scope": "constant.language",
      "foreground": "#75d6a0"
    },
    {
      "scope": "constant.character",
      "foreground": "#75d6a0"
    },
    {
      "scope": "keyword",
      "foreground": "#8aa4ff"
    },
    {
      "scope": "keyword.control",
      "foreground": "#8aa4ff"
    },
    {
      "scope": "storage",
      "foreground": "#8aa4ff"
    },
    {
      "scope": "storage.type",
      "foreground": "#c9b27a"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#a8bbff"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#c3d0ff"
    },
    {
      "scope": "support.function",
      "foreground": "#c3d0ff"
    },
    {
      "scope": "entity.name.type",
      "foreground": "#c9b27a"
    },
    {
      "scope": "support.type",
      "foreground": "#c9b27a"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#ff9b73"
    },
    {
      "scope": "support.class",
      "foreground": "#ff9b73"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#7fd6c0"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#b9c2e0"
    },
    {
      "scope": "variable",
      "foreground": "#eef1ff"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#c3d0ff"
    },
    {
      "scope": "variable.other.property",
      "foreground": "#e0c07a"
