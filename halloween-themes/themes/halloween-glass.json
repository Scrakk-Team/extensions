    },
    {
      "scope": "punctuation",
      "foreground": "#8e9ab8"
    },
    {
      "scope": "markup.heading",
      "foreground": "#8aa4ff",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#e0c07a",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#c3d0ff",
      "fontStyle": "italic"
    }
