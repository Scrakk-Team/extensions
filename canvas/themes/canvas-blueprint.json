    "active": "#173553",
    "scrollbarThumb": "#24486a",
    "scrollbarThumbHover": "#31618c",
    "indentGuide": "#1b3a58",
    "diffAdded": "rgba(74,222,128,0.14)",
    "diffRemoved": "rgba(255,107,107,0.16)",
    "diffModified": "rgba(247,201,72,0.16)"
  },
  "tokenColors": [
    { "scope": "comment", "foreground": "#5c81a3", "fontStyle": "italic" },
    { "scope": "string", "foreground": "#7fe3b0" },
    { "scope": "string.regexp", "foreground": "#a5efc9" },
    { "scope": "constant.numeric", "foreground": "#ffb454" },
    { "scope": "constant.language", "foreground": "#f7c948" },
    { "scope": "constant.character", "foreground": "#f7c948" },
    { "scope": "keyword", "foreground": "#5aa9e6" },
    { "scope": "keyword.control", "foreground": "#5aa9e6" },
    { "scope": "storage", "foreground": "#64b5f6" },
    { "scope": "storage.type", "foreground": "#64b5f6" },
    { "scope": "keyword.operator", "foreground": "#9ad8ff" },
    { "scope": "entity.name.function", "foreground": "#7dd3fc" },
    { "scope": "support.function", "foreground": "#7dd3fc" },
    { "scope": "entity.name.type", "foreground": "#9ad8ff" },
    { "scope": "support.type", "foreground": "#9ad8ff" },
    { "scope": "entity.name.class", "foreground": "#f7c948" },
    { "scope": "support.class", "foreground": "#f7c948" },
    { "scope": "entity.name.tag", "foreground": "#ff8fa3" },
    { "scope": "entity.other.attribute-name", "foreground": "#ffc46b" },
    { "scope": "variable", "foreground": "#dceafa" },
    { "scope": "variable.parameter", "foreground": "#ffb3c7" },
    { "scope": "variable.other.property", "foreground": "#7fe3b0" },
    { "scope": "meta.object-literal.key", "foreground": "#7fe3b0" },
    { "scope": "support.type.property-name", "foreground": "#7fe3b0" },
    { "scope": "punctuation", "foreground": "#6f93b3" },
    { "scope": "markup.heading", "foreground": "#5aa9e6", "fontStyle": "bold" },
    { "scope": "markup.bold", "foreground": "#ff8fa3", "fontStyle": "bold" },
    { "scope": "markup.italic", "foreground": "#7dd3fc", "fontStyle": "italic" }
  ],
  "fonts": {
    "ui": {
      "family": "Space Mono",
      "source": "https://fonts.gstatic.com/s/spacemono/v17/i7dPIFZifjKcF5UAWdDRYEF8RQ.woff2",
