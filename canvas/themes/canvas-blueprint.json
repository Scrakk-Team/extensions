{
  "name": "Canvas Blueprint",
  "type": "dark",
  "colors": {
    "bg": "#08111c",
    "surface": "#0d1c2c",
    "surfaceRaised": "#12263a",
    "border": "#1e3d5c",
    "borderStrong": "#2c5c86",
    "panelBorder": "#22456a",
    "editorBg": "#071320",
    "titleBarBg": "#0a1727",
    "activityBarBg": "#081422",
    "statusBarBg": "#0c1c2e",
    "accent": "#4ea8de",
